{
  "manifest_version": 3,
  "name": "GatilhoBR",
  "version": "4.3.0",
  "key": "",
  "description": "Sincroniza mercados ao vivo e coordena binds entre abas, com execução por casa e diagnóstico local.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "debugger",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://sclfkfghbvuchyubcksr.supabase.co/*",
    "https://api.cakto.com.br/*",
    "https://cakto-sdk.pages.dev/*",
    "https://d354c9v5bptm0r.cloudfront.net/*",
    "https://kvnpji2t.jjysjnuego.com/*",
    "https://*.nethone.com/*",
    "https://*.betfair.bet.br/*",
    "https://*.betfair.com/*",
    "https://*.bet365.bet.br/*",
    "https://*.bet365.com/*",
    "https://*.betnacional.com/*",
    "https://*.betnacional.bet.br/*",
    "https://*.betnacional.br/*",
    "https://betano.bet.br/*",
    "https://*.betano.bet.br/*",
    "https://betmgm.bet.br/*",
    "https://*.betmgm.bet.br/*",
    "https://superbet.bet.br/*",
    "https://*.superbet.bet.br/*",
    "https://superbet.com/*",
    "https://*.superbet.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "sandbox": {
    "pages": [
      "dashboard-app/dist/cakto-sdk-bridge.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups; script-src 'self' https://cakto-sdk.pages.dev https://d354c9v5bptm0r.cloudfront.net; connect-src 'self' https://api.cakto.com.br https://cakto-sdk.pages.dev https://d354c9v5bptm0r.cloudfront.net https://kvnpji2t.jjysjnuego.com https://*.nethone.com; img-src 'self' data: https:; object-src 'self';"
  },
  "action": {
    "default_title": "GatilhoBR",
    "default_icon": {
      "16": "assets/icons/gatilho-16.png",
      "32": "assets/icons/gatilho-32.png",
      "48": "assets/icons/gatilho-48.png",
      "128": "assets/icons/gatilho-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/gatilho-16.png",
    "32": "assets/icons/gatilho-32.png",
    "48": "assets/icons/gatilho-48.png",
    "128": "assets/icons/gatilho-128.png"
  },
  "commands": {
    "dynamic-bind-slot-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Disparar bind global 1",
      "global": true
    },
    "dynamic-bind-slot-2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "Disparar bind global 2",
      "global": true
    },
    "dynamic-bind-slot-3": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "Command+Shift+3"
      },
      "description": "Disparar bind global 3",
      "global": true
    },
    "dynamic-bind-slot-4": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "Command+Shift+4"
      },
      "description": "Disparar bind global 4",
      "global": true
    },
    "trigger_place_bet_global": {
      "description": "Disparar Aposta (Global / Sem Foco)",
      "global": true
    },
    "trigger-focused": {
      "description": "Disparar Aposta (Aba em Foco)",
      "global": true
    },
    "trigger-bet365": {
      "description": "Disparar Aposta Bet365 (Background)",
      "global": true
    },
    "trigger-betfair": {
      "description": "Disparar Aposta Betfair (Background)",
      "global": true
    }
  },
