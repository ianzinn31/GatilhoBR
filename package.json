{
  "name": "gatilhobr-desktop",
  "version": "4.3.0",
  "description": "GatilhoBR Desktop - Sincronizador e Disparador de Apostas Esportivas de Alta Performance",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:native-host": "node scripts/build-native-host.js",
    "build:extension-release": "node scripts/build-extension-release.js",
    "build:release": "npm run build:native-host && npm run build:extension-release && npm run dist",
    "test": "node --test tests/**/*.test.js tests/*.test.js",
    "reset-onboarding": "powershell -ExecutionPolicy Bypass -File scripts/reset-onboarding.ps1",
    "release:publish": "node scripts/deploy-github-release.js",
    "dist": "npm run build:native-host && electron-builder --win",
    "pack": "npm run build:native-host && electron-builder --dir"
  },
  "keywords": [
    "betting",
    "trading",
    "bet365",
    "betfair",
    "automation",
    "electron"
  ],
  "author": "GatilhoBR Team",
  "license": "ISC",
  "devDependencies": {
    "crx3": "^2.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.gatilhobr.desktop",
    "productName": "GatilhoBR",
    "directories": {
      "output": "dist-desktop"
    },
    "publish": {
      "provider": "github",
      "owner": "ianzinn31",
      "repo": "GatilhoBR"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/gatilho-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer/installer.nsh"
    },
    "afterPack": "build/installer/onboarding-launcher.js",
    "files": [
      "assets/**/*",
      "dist-native/gatilhobr-host.exe",
      "dashboard-app/**/*",
      "electron/**/*",
      "native-host/**/*",
      "scripts/**/*",
      "src/**/*",
      "background.js",
      "content.js",
      "dashboard.css",
      "dashboard.html",
      "dashboard.js",
      "inject.js",
      "options.html",
      "options.js",
      "popup.html",
      "popup.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-native/gatilhobr-host.exe",
        "to": "native-host/gatilhobr-host.exe"
      },
      {
        "from": "build/installer/register-integration.ps1",
        "to": "installer/register-integration.ps1"
      },
      {
        "from": "build/installer/open-extension-guide.html",
        "to": "installer/open-extension-guide.html"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
